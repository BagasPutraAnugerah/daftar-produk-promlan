<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
    <top>
        <HBox spacing="16" styleClass="header">
            <Label styleClass="title" text="Daftar Produk" />
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="16" styleClass="page">
                    <VBox spacing="12" styleClass="card">
                        <Label styleClass="subtitle" text="Tambah produk baru" />
                        <Label text="Nama produk" />
                        <TextField fx:id="namaField" />
                        <Label text="Kategori" />
                        <ComboBox fx:id="kategoriBox" maxWidth="Infinity" />
                        <Label text="Harga produk (Rp)" />
                        <TextField fx:id="hargaField" promptText=" 0-99999.." />
                        <Label styleClass="muted" text="Kode produk dibuat otomatis (PR001, PR002, ...)." wrapText="true" />
                        <Button maxWidth="Infinity" onAction="#simpan" styleClass="button-primary" text="Simpan Produk" />
                        <Label fx:id="pesanLabel" styleClass="error" wrapText="true" />
                     <Button onAction="#bukaDaftar" text="Lihat Daftar" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
